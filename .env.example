# Copy to .env.local and fill in. Never commit real values.
#
# Supabase (optional: without them the game plays local-only, which is also how `npm run e2e`
# runs). For the local stack, `npx supabase status -o env` prints API_URL and ANON_KEY.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only (never NEXT_PUBLIC_): used by server code and tooling, not the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Server-only: comma-separated emails allowed into /mod. Empty means nobody.
MODERATOR_EMAILS=
# Server-only: this site's public origin (e.g. https://cloutcity.example). /mod sign-in links land
# on <SITE_URL>/mod; it is never taken from the request's Host header. Unset: /mod sign-in is off.
# Keep email confirmations on in the hosted project: /mod accepts only email-link sessions.
SITE_URL=
# Browser: the same origin as SITE_URL (the build refuses two different ones). Account links
# (save progress, log in, Google) come back to <NEXT_PUBLIC_SITE_URL>/auth/callback; unset turns
# accounts off ("Accounts aren't set up on this version"), never a guess from the page's host.
NEXT_PUBLIC_SITE_URL=
# Supabase CLI only (supabase/config.toml [auth.external.google]): a Google OAuth client for the
# local stack, optional (Google stays off locally without it).
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
